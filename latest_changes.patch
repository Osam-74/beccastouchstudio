+import { useEffect, useState } from 'react';
+import { Trash2, RefreshCw, CheckCircle2, Clock, PackageSearch, ChevronDown, ChevronUp } from 'lucide-react';
+import { bookingApi } from '../utils/bookingApi';
+import { useToast } from '../hooks/useToast';
+
+const STATUS_STYLES = {
+  pending:   'bg-[#fff4e0] text-[#a07428] border-[#f0d898]',
+  viewed:    'bg-[#f0f4ff] text-[#3a5aaa] border-[#b8c8f0]',
+  done:      'bg-[#f0faf3] text-[#3d7a53] border-[#b8e0c8]',
+  cancelled: 'bg-[#fff0f0] text-[#a84040] border-[#f0c8c8]',
+};
+
+const FILTERS = ['all','pending','viewed','done','cancelled'];
+
+function Badge({ status }) {
+  return <span className={`px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-[0.18em] font-semibold border ${STATUS_STYLES[status]||STATUS_STYLES.pending}`}>{status}</span>;
+}
+
+export default function AdminOrdersTab({ pin }) {
+  const [orders, setOrders] = useState([]);
+  const [loading, setLoading] = useState(true);
+  const [filter, setFilter] = useState('all');
+  const [expanded, setExpanded] = useState(null);
+  const [updating, setUpdating] = useState('');
+  const { showToast } = useToast();
+
+  async function load() {
+    try {
+      setLoading(true);
+      const { orders: list } = await bookingApi.adminGetShopOrders(pin);
+      setOrders(list || []);
+    } catch(e) { showToast(e.message, 'error'); }
+    finally { setLoading(false); }
+  }
+  useEffect(() => { load(); }, []);
+
+  async function updateStatus(orderId, status) {
+    try {
+      setUpdating(orderId);
+      await bookingApi.adminUpdateShopOrder(pin, orderId, status, '');
+      setOrders(prev => prev.map(o => o.order_id === orderId ? { ...o, status } : o));
+      showToast(`Order marked as ${status}.`, 'success');
+    } catch(e) { showToast(e.message, 'error'); }
+    finally { setUpdating(''); }
+  }
+
+  async function del(orderId) {
+    if (!window.confirm('Delete this order permanently?')) return;
+    try {
+      await bookingApi.adminDeleteShopOrder(pin, orderId);
+      setOrders(prev => prev.filter(o => o.order_id !== orderId));
+      showToast('Order deleted.', 'success');
+    } catch(e) { showToast(e.message, 'error'); }
+  }
+
+  const visible = filter === 'all' ? orders : orders.filter(o => o.status === filter);
+  const pendingCount = orders.filter(o => o.status === 'pending').length;
+
+  return (
+    <div className="space-y-5 max-w-2xl">
+      {/* header */}
+      <div className="flex items-center justify-between gap-3 flex-wrap">
+        <div>
+          <p className="font-semibold text-[#1c1214]">Shop Orders</p>
+          <p className="text-xs text-[#9a7080]">
+            {orders.length} total
+            {pendingCount > 0 && <span className="ml-2 inline-flex items-center gap-1 text-[#a07428] font-semibold"><Clock size={10}/> {pendingCount} pending</span>}
+          </p>
+        </div>
+        <button type="button" onClick={load} className="w-9 h-9 rounded-full border border-[#eecdd4] bg-white flex items-center justify-center shadow-sm">
+          <RefreshCw size={13} className={loading ? 'animate-spin' : ''} style={{animationDuration:'1.5s'}}/>
+        </button>
+      </div>
+
+      {/* filters */}
+      <div className="flex gap-2 flex-wrap">
+        {FILTERS.map(f => (
+          <button key={f} type="button" onClick={() => setFilter(f)}
+            className={`px-3 py-1.5 rounded-full text-xs font-semibold border transition-all capitalize ${filter===f?'bg-[#3d1f6e] text-white border-transparent':'bg-white border-[#eecdd4] text-[#7a5460]'}`}>
+            {f === 'all' ? `All (${orders.length})` : `${f} (${orders.filter(o=>o.status===f).length})`}
+          </button>
+        ))}
+      </div>
+
+      {loading && <div className="rose-card p-5 text-sm text-[#9a7080]">Loading orders…</div>}
+
+      {!loading && visible.length === 0 && (
+        <div className="rose-card p-10 text-center">
+          <PackageSearch size={32} className="mx-auto text-[#e8c4cc] mb-3"/>
+          <p className="text-sm text-[#9a7080]">No {filter !== 'all' ? filter : ''} orders yet.</p>
+        </div>
+      )}
+
+      <div className="space-y-3">
+        {visible.map(o => {
+          let items = [];
+          try { items = JSON.parse(o.items || '[]'); } catch {}
+          const isExp = expanded === o.order_id;
+          const busy = updating === o.order_id;
+
+          return (
+            <div key={o.order_id} className="glass-card overflow-hidden">
+              <button type="button" onClick={() => setExpanded(isExp ? null : o.order_id)}
+                className="w-full text-left p-4 flex items-start gap-3">
+                <div className="flex-1 min-w-0">
+                  <div className="flex items-center gap-2 mb-1 flex-wrap">
+                    <p className="font-semibold text-sm text-[#3d1f6e]">{o.client_name}</p>
+                    <Badge status={o.status || 'pending'}/>
+                    {o.delivery_type === 'home' && (
+                      <span className="px-2 py-0.5 rounded-full bg-[#f0e8ff] text-[#6b3fa0] text-[9px] font-semibold border border-[#d4b8f0]">HOME DELIVERY</span>
+                    )}
+                  </div>
+                  <p className="font-mono text-xs text-[#9a7080]">{o.order_id}</p>
+                  <p className="text-xs text-[#7a5460] mt-0.5">{o.phone} · ₦{Number(o.total_amount||0).toLocaleString()}</p>
+                  <p className="text-[10px] text-[#9a7080] mt-0.5">{items.length} item{items.length!==1?'s':''}</p>
+                </div>
+                {isExp ? <ChevronUp size={15} className="text-[#9a7080] shrink-0 mt-1"/> : <ChevronDown size={15} className="text-[#9a7080] shrink-0 mt-1"/>}
+              </button>
+
+              {isExp && (
+                <div className="px-4 pb-4 space-y-3 border-t border-[#eecdd4] pt-3">
+                  {/* items list */}
+                  {items.length > 0 && (
+                    <div className="rounded-xl bg-[#fdf8f5] border border-[#eed4da] p-3 space-y-1.5">
+                      <p className="text-[10px] font-bold text-[#3d1f6e] uppercase tracking-[0.18em] mb-2">Items ordered</p>
+                      {items.map((i,idx) => (
+                        <div key={idx} className="flex items-center justify-between text-xs">
+                          <span className="text-[#5a3a42]">{i.name} ×{i.qty}</span>
+                          <span className="font-semibold text-[#3d1f6e]">₦{(i.price*i.qty).toLocaleString()}</span>
+                        </div>
+                      ))}
+                      <div className="flex items-center justify-between text-sm font-bold text-[#c8788a] pt-2 border-t border-[#eecdd4] mt-1">
+                        <span>Total</span><span>₦{Number(o.total_amount||0).toLocaleString()}</span>
+                      </div>
+                    </div>
+                  )}
+                  {/* contact */}
+                  <div className="grid grid-cols-2 gap-2 text-xs">
+                    <div className="rounded-xl bg-white border border-[#eed4da] px-3 py-2">
+                      <p className="text-[8px] uppercase tracking-[0.2em] text-[#9a7080] mb-0.5">Phone</p>
+                      <p className="text-[#3d1f6e] font-semibold">{o.phone}</p>
+                    </div>
+                    {o.email && (
+                      <div className="rounded-xl bg-white border border-[#eed4da] px-3 py-2">
+                        <p className="text-[8px] uppercase tracking-[0.2em] text-[#9a7080] mb-0.5">Email</p>
+                        <p className="text-[#3d1f6e] font-semibold truncate">{o.email}</p>
+                      </div>
+                    )}
+                    <div className="rounded-xl bg-white border border-[#eed4da] px-3 py-2">
+                      <p className="text-[8px] uppercase tracking-[0.2em] text-[#9a7080] mb-0.5">Delivery</p>
+                      <p className="text-[#3d1f6e] font-semibold">{o.delivery_type === 'home' ? 'Home delivery' : 'Self pickup'}</p>
+                    </div>
+                    {o.notes && (
+                      <div className="col-span-2 rounded-xl bg-[#fffbf0] border border-[#f0e4b8] px-3 py-2">
+                        <p className="text-[8px] uppercase tracking-[0.2em] text-[#a07428] mb-0.5">Notes</p>
+                        <p className="text-[#6a5020]">{o.notes}</p>
+                      </div>
+                    )}
+                  </div>
+
+                  {/* actions */}
+                  <div className="flex gap-2 flex-wrap">
+                    {o.status !== 'viewed' && (
+                      <button type="button" onClick={() => updateStatus(o.order_id, 'viewed')} disabled={busy}
+                        className="flex-1 py-2.5 rounded-xl bg-[#f0f4ff] border border-[#b8c8f0] text-[#3a5aaa] text-xs font-semibold disabled:opacity-50">
+                        Mark viewed
+                      </button>
+                    )}
+                    {o.status !== 'done' && (
+                      <button type="button" onClick={() => updateStatus(o.order_id, 'done')} disabled={busy}
+                        className="flex-1 py-2.5 rounded-xl bg-[#f0faf3] border border-[#b8e0c8] text-[#3d7a53] text-xs font-semibold flex items-center justify-center gap-1 disabled:opacity-50">
+                        <CheckCircle2 size={11}/> Done
+                      </button>
+                    )}
+                    {o.status !== 'pending' && (
+                      <button type="button" onClick={() => updateStatus(o.order_id, 'pending')} disabled={busy}
+                        className="flex-1 py-2.5 rounded-xl border border-[#eecdd4] text-[#7a5460] text-xs font-semibold disabled:opacity-50">
+                        Back to pending
+                      </button>
+                    )}
+                    <button type="button" onClick={() => del(o.order_id)} disabled={busy}
+                      className="w-10 py-2.5 rounded-xl border border-[#f0c8c8] bg-white text-[#b05860] flex items-center justify-center disabled:opacity-50">
+                      <Trash2 size={12}/>
+                    </button>
+                  </div>
+                </div>
+              )}
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
