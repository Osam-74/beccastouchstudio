# Firebase Web SDK (used by the frontend — safe to include in build)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key

# Firebase Admin SDK (used ONLY by the backend function — never commit real values)
# Add these as secrets in your Deno Deploy project (or wherever you host the function)
FIREBASE_PROJECT_ID=beccastouch-studio
FIREBASE_CLIENT_EMAIL=your-service-account@beccastouch-studio.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gmail OAuth2 (set in Deno Deploy — stored in Firestore after first setup)
# You can pre-set these here OR set them through the Admin > Settings > Email panel
GMAIL_CLIENT_ID=your_oauth2_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your_secret
